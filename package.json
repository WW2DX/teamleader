{
  "name": "team-leader",
  "version": "1.6.5",
  "description": "Team Leader \u2014 DXpedition Logger",
  "author": "WW2DX",
  "main": "electron/main.js",
  "homepage": ".",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "electron-dev": "NODE_ENV=development electron .",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --mac --linux",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "sql.js": "^1.12.0",
    "uuid": "^9.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.ww2dx.teamleader",
    "productName": "Team Leader",
    "copyright": "Copyright \u00a9 2025 WW2DX",
    "files": [
      "server.js",
      "cat-bridge.js",
      "config.json",
      "config.operator.json",
      "public/**",
      "electron/**",
      "flexbridge/**",
      "node_modules/**",
      "!node_modules/.cache",
      "!**/*.map"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "electron/build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "${productName} ${version}",
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "icon": "electron/build/icon.png",
      "category": "HamRadio",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  }
}